{
  "expo": {
    "name": "JackFit",
    "slug": "jackfit",
    "scheme": "jackfit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/uma_icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a0ee710a-df1d-4030-b32d-419e45cf697e"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jackfit.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "JackFit lit tes données de santé pour évaluer ta forme et donner des conseils personnalisés.",
          "NSHealthUpdateUsageDescription": "JackFit ne modifie jamais tes données Santé. Cette permission n'est pas utilisée par l'app."
        }
      ],
      "@react-native-vector-icons/ant-design",
      "expo-font",
      "expo-splash-screen",
      "expo-localization",
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "extra": {
      "eas": {
        "projectId": "a0ee710a-df1d-4030-b32d-419e45cf697e"
      }
    }
  }
}

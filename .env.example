# URL de l'API backend (localhost en dev, URL de prod en deploy)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Supabase — Settings > API Keys
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# PostHog analytics (optional — les 2 doivent être définies pour activer, sinon no-op)
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_...
EXPO_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
